{
  "name": "moly-desktop",
  "version": "1.0.0",
  "description": "Moly Desktop - Local AI Chat with Ollama",
  "main": "src/main.js",
  "homepage": "./",
  "author": "Moly",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev": "react-scripts start",
    "build": "react-scripts build && electron-builder",
    "build-win": "react-scripts build && electron-builder --win",
    "build-mac": "react-scripts build && electron-builder --mac",
    "build-linux": "react-scripts build && electron-builder --linux",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.1",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
