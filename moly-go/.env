# Moly Local Testing Configuration

# API Key (using a test key - will need real Claude API key for actual testing)
CLAUDE_API_KEY=sk-ant-test-key-for-local-development

# Model Configuration
AGENT_MODEL=claude-opus-5
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000
AGENT_TIMEOUT_SECONDS=30

# Database (SQLite - no setup needed, creates automatically)
DATABASE_URL=sqlite:moly.db

# Server
PORT=11436
HOST=localhost
ENVIRONMENT=development
LOG_LEVEL=debug

# Features
ENABLE_V2_API=true
ENABLE_AGENT_SYSTEM=true
ENABLE_SAFETY_CHECKS=true

# Privacy (critical - do not modify)
ENABLE_CONTACT_SURVEILLANCE=false
TRACK_USER_BEHAVIOR_ONLY=true
STORE_CONTACT_OBSERVATIONS_ONLY=true

# Development
SEED_DEMO_DATA=false
RESET_DATABASE_ON_START=false
