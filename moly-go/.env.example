# Moly v2 Agent-Based Architecture Configuration

# === Claude API Configuration ===
CLAUDE_API_KEY=sk-ant-YOUR_API_KEY_HERE
AGENT_MODEL=claude-opus-5
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000
AGENT_TIMEOUT_SECONDS=30

# === Database Configuration ===
DATABASE_URL=postgres://user:password@localhost:5432/moly
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=5m

# === V2 Agent System Configuration ===
# Agent Pool Configuration
CONVERSATION_AGENTS=10
LEARNING_AGENTS=5
CONTEXT_MANAGERS=5
RISK_MONITORS=3
QUEUE_SIZE=1000

# === V2 Feature Flags ===
# Enable V2 API endpoints
ENABLE_V2_API=true
ENABLE_AGENT_SYSTEM=true
ENABLE_LEARNING_AGENT=true
ENABLE_RISK_MONITOR=true

# === Safety Configuration ===
# Safety checks for crisis/illegal content
ENABLE_SAFETY_CHECKS=true
ENABLE_CRISIS_DETECTION=true
ENABLE_ILLEGAL_DETECTION=true

# === CRITICAL: Privacy Configuration ===
# These settings enforce privacy constraints - DO NOT MODIFY
ENABLE_CONTACT_SURVEILLANCE=false
TRACK_USER_BEHAVIOR_ONLY=true
STORE_CONTACT_OBSERVATIONS_ONLY=true

# === Server Configuration ===
PORT=11436
HOST=localhost
ENVIRONMENT=development
LOG_LEVEL=info

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === CORS ===
ALLOWED_ORIGINS=chrome-extension://*

# === Performance Optimization ===
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
SUGGESTION_CACHE_SIZE=1000

# === Monitoring & Observability ===
SENTRY_DSN=
DATADOG_API_KEY=
ENABLE_METRICS=true
METRICS_PORT=9090

# === Development Mode ===
SEED_DEMO_DATA=false
RESET_DATABASE_ON_START=false
