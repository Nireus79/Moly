# Moly Installer Configuration
# Copy to .env and update values for your environment

# Chrome Extension ID (obtained after Web Store publication)
# Run: chrome://extensions/ (Developer Mode ON) and copy your extension's ID
MOLY_EXTENSION_ID=your-extension-id-here

# Chrome Web Store URL (obtained after Web Store publication)
# Format: https://chromewebstore.google.com/detail/moly-messaging-coach/EXTENSION_ID
MOLY_WEBSTORE_URL=https://chromewebstore.google.com/detail/moly-messaging-coach/[YOUR_EXTENSION_ID]

# Release version for downloading binaries
# Must match the GitHub release tag
MOLY_RELEASE_VERSION=v1.0.0

# GitHub repository for releases
# Change if forking or using different repo
MOLY_GITHUB_REPO=Nireus79/Moly
