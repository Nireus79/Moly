# Moly: environment variables (all optional). An installed Moly needs none of them: the AI provider and key are set in the
# extension's Settings and stored in the encrypted database. Variables win over saved settings, so they are for development.
# Copy to moly-go/.env or export them in your shell.

# --- AI provider (development override) ---
# ollama | claude | openai | claude-cli (testing only). Unset: Ollama is used if it answers, otherwise nothing until Settings.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=
OLLAMA_ENDPOINT=http://127.0.0.1:11434
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000
AGENT_TIMEOUT_SECONDS=900

# --- Server ---
MOLY_PORT=:11436
MOLY_LOG_LEVEL=info
# 1 shows message text in logs (debugging only: logs are otherwise scrubbed of user content)
MOLY_LOG_CONTENT=
# off disables rate limiting (load tests)
MOLY_RATE_LIMIT=

# --- Database ---
# 64 hex characters. Normally the key lives in the operating system's keychain; set this where there is none.
MOLY_DB_KEY=

# --- Installed mode (set by the native host, not by hand) ---
# 1: loopback only, extension origins only, per-run token
MOLY_PRODUCTION=
# 1: exit about 30 seconds after the last browser detaches
MOLY_IDLE_EXIT=
# comma separated extension IDs allowed to talk to the app (also read from ~/.moly/extension-ids.txt)
MOLY_EXTENSION_IDS=
