{
  "manifest_version": 3,
  "name": "Moly - Messaging Coach",
  "version": "0.1.0",
  "description": "AI-powered messaging coach that helps you craft better responses on any website",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/contentScript.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Moly - Messaging Coach",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "512": "images/icon-512.png"
  },
  "side_panel": {
    "default_path": "dist/sidebar/sidebar.html"
  },
  "options_page": "dist/settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["dist/content/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
