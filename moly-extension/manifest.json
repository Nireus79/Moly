{
  "manifest_version": 3,
  "name": "Moly - Messaging Coach",
  "version": "0.1.0",
  "description": "AI-powered messaging coach that helps you craft better responses through conversation",
  "permissions": [
    "storage",
    "notifications",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Moly - Messaging Coach",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "options_page": "settings/settings.html"
}
